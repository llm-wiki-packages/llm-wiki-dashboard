# Every variable the server reads. Defaults are in server/src/config/index.ts;
# copy this to .env and change what you need. Nothing else reads the environment.

# live: the machine's registered wikis through llm-wiki-cli. fixtures: the demo dataset.
DASHBOARD_SOURCE=live
# read is the only mode v0 ships. write is plumbed so the UI can show it.
DASHBOARD_MODE=read
DASHBOARD_BIND=127.0.0.1
DASHBOARD_PORT=4180
# The machine CLI, as a command line (split on spaces).
DASHBOARD_CLI=llm-wiki-cli
DASHBOARD_CLI_TIMEOUT_MS=15000
# How long a view answer is reused before the CLI is asked again.
DASHBOARD_CACHE_MS=5000
# Unset: a fresh token per start, printed with the URL. 0 disables the gate (local hacking only).
# DASHBOARD_TOKEN=
DASHBOARD_TOKEN_REQUIRED=1
DASHBOARD_OPEN=1
DASHBOARD_LOG_LEVEL=info
# Replay's timeline cache (SQLite). Default: $XDG_STATE_HOME/llm-wiki-dashboard, or :memory:.
# DASHBOARD_STATE_DIR=
DASHBOARD_REPLAY_DAYS=30
# Ask the wiki: the gear's closed lists (first is the default), the skill's slash command, and a time limit.
DASHBOARD_ASK_MODELS=sonnet,opus,haiku
DASHBOARD_ASK_EFFORTS=medium,low,high
DASHBOARD_ASK_PREFIX=/ask
DASHBOARD_ASK_TIMEOUT_MS=300000
